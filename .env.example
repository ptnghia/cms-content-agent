# --- Network ---
HOST=127.0.0.1            # keep behind an HTTPS reverse proxy (see docs/DEPLOY.md); 0.0.0.0 inside Docker
PORT=3000

# --- Agent CLI: claude | codex | agy ---
AGENT_BACKEND=claude      # primary: claude | api | codex | agy
AGENT_FALLBACK=           # backup CLI used when the primary fails (e.g. codex); empty = off
AGENT_FALLBACK_COOLDOWN_SEC=300  # after a primary failure, try the backup first for this long

# --- Claude Code (needs `claude` logged in, or ANTHROPIC_API_KEY in the service environment) ---
CLAUDE_BIN=claude
CLAUDE_MODEL=             # recommended: sonnet (about 40% cheaper than the CLI default in our field test); empty = CLI default
CLAUDE_PERMISSION_MODE=acceptEdits
CLAUDE_DISALLOWED_TOOLS=Bash,WebFetch,WebSearch,NotebookEdit   # agent works on workspace files only
CLAUDE_MAX_TURNS=         # optional cap on agent steps per request
CLAUDE_TIMEOUT_SEC=       # empty = AGY_TIMEOUT_SEC

# --- Claude API (AGENT_BACKEND=api): no CLI process, needs ANTHROPIC_API_KEY ---
ANTHROPIC_API_KEY=
API_MODEL=                # default claude-opus-5-5; e.g. claude-sonnet-5-5 (half the price)
API_EFFORT=medium         # low | medium | high | xhigh | max
API_MAX_TOOL_ROUNDS=40    # tool calls per request before the agent must answer
API_FALLBACKS=1           # 0 = no server-side model fallback when a request is refused
API_PRICES=               # JSON override of the price table, e.g. {"claude-sonnet-5-5":{"input":2,"output":10,"cacheRead":0.1}}

# --- Codex (needs `codex login`) ---
CODEX_BIN=codex
CODEX_MODEL=              # empty = CLI default; list with `codex debug models`
CODEX_EFFORT=             # low|medium|high
CODEX_SANDBOX=workspace-write   # can write the workspace, no network
CODEX_TIMEOUT_SEC=        # empty = AGY_TIMEOUT_SEC

# --- agy ---
AGY_BIN=agy
AGY_MODEL=
AGY_MODE=accept-edits     # headless: can write files, commands are refused
AGY_TIMEOUT_SEC=300       # also the default timeout for the other CLIs

# --- Limits ---
MAX_CONCURRENT=2          # agent runs at the same time, machine-wide
MAX_MESSAGE_CHARS=8000
CHAT_PER_HOUR=60          # chat requests per user per hour (0 = unlimited)
COMPOSE_PER_HOUR=12       # editor "write with AI" requests per user per hour (0 = unlimited)

# --- Data ---
DATA_DIR=./data
STORE_DRIVER=file         # file | sqlite (Node >= 22.13; migrate with `npm run migrate:sqlite`)
SITES_FILE=./config/sites.json
WORKSPACE_LOCK=1          # make synced data read-only for the agent between syncs (0 = off)

# --- Sync ---
SYNC_INTERVAL_MIN=0       # >0: sync every site periodically
SYNC_ALERT_WEBHOOK=       # POST JSON here when sync keeps failing / recovers (Slack/Discord compatible)
SYNC_ALERT_AFTER=2        # consecutive failures before alerting

# --- Development only: demo page at "/" and tokens from /dev/token ---
DEV_MODE=0
