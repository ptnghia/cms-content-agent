# --- Mạng ---
HOST=127.0.0.1            # đặt sau reverse proxy HTTPS (xem docs/DEPLOY.md)
PORT=3000
# --- Agent CLI: agy (mặc định) hoặc codex ---
AGENT_BACKEND=agy        # CLI chính: agy | codex
AGENT_FALLBACK=           # CLI dự phòng khi CLI chính lỗi (vd: codex); trống = tắt
AGENT_FALLBACK_COOLDOWN_SEC=300  # sau khi CLI chính lỗi, tạm dùng dự phòng trước trong khoảng này
# --- agy ---
AGY_BIN=agy
AGY_MODEL=
AGY_MODE=accept-edits     # headless: ghi file được, chạy lệnh bị từ chối -> backend tự đồng bộ dữ liệu
AGY_TIMEOUT_SEC=300
# --- codex (khi AGENT_BACKEND=codex; cần `codex login`) ---
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-terra  # model có sẵn tuỳ tài khoản: `codex debug models`
CODEX_EFFORT=              # low|medium|high (để trống = mặc định của model)
CODEX_SANDBOX=workspace-write  # ghi được trong workspace, không có mạng
CODEX_TIMEOUT_SEC=         # trống = dùng AGY_TIMEOUT_SEC
# --- Giới hạn ---
MAX_CONCURRENT=2          # số lượt agy chạy đồng thời
MAX_MESSAGE_CHARS=8000
# --- Dữ liệu ---
DATA_DIR=./data
STORE_DRIVER=file         # file (mặc định); driver khác: xem server/store.mjs
SITES_FILE=./config/sites.json
SYNC_INTERVAL_MIN=0       # >0: tự đồng bộ bài viết định kỳ
# --- Chỉ dùng khi phát triển: bật trang demo "/" và cấp token tại /dev/token ---
DEV_MODE=0
